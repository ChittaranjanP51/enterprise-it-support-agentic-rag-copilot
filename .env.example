# LLM provider: "groq" or "openai"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=it-support-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Tavily web search
TAVILY_API_KEY=

# Embeddings (384-dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=4
